# ============================================================================
# LOCAL DEVELOPMENT & RAILWAY/VERCEL TEMPLATE (SAFE TEMPLATE — NO SECRETS)
# Note: Production on Railway reads Railway Service Variables directly (no .env file).
# ============================================================================

NODE_ENV=development
PORT=3000

# MongoDB Atlas (Include your target database name before '?')
MONGODB_URI=mongodb+srv://[YOUR_DATABASE_USERNAME]:[YOUR_DATABASE_PASSWORD]@[YOUR_CLUSTER_HOST]/shawan-school%26college?retryWrites=true&w=majority
# JWT Secret (Required >= 32 characters in production; generate via: openssl rand -hex 32)
JWT_SECRET=replace_with_minimum_32_character_cryptographic_secret

# CORS Trusted Origins (Local Vite dev or exact Vercel frontend URL, e.g. https://school-college_managment-system.vercel.app)
CORS_ORIGIN=http://localhost:5173

# Upload Storage Directory (Local ./data/uploads or Railway Volume mount path, e.g. /data/uploads)
UPLOAD_STORAGE_DIR=./data/uploads

# Seed Guards (Keep ALLOW_PRODUCTION_SEED=false so Atlas data is never auto-seeded)
ALLOW_PRODUCTION_SEED=false
DISABLE_AUTO_SEED=true

# Gemini API Key (Optional server-side key; never expose with VITE_ prefix)
GEMINI_API_KEY=

# One-Time Initial Super Admin Bootstrap (Set temporarily >= 32 chars for fresh DB bootstrap, then remove)
BOOTSTRAP_SECRET=

# Transactional SMTP Configuration for Forgot Password Emails (Optional; fails safely with HTTP 503 if omitted)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Shawan School & College <no-reply@shawanschool.edu.pk>"
APP_PUBLIC_URL=https://school-college_managment-system.vercel.app

# ============================================================================
# FRONTEND CONFIGURATION (Vercel Environment Variables)
# ============================================================================

# Leave empty for same-origin unified server; set on Vercel to your Railway public HTTPS URL (e.g. https://<service>.up.railway.app)
VITE_API_BASE_URL=