# ============================================================================
# BACKEND ENVIRONMENT CONFIGURATION (SAFE TEMPLATE — NO SECRETS)
# ============================================================================

NODE_ENV=development
PORT=3000

# MongoDB Atlas (Use dedicated least-privilege database user)
MONGODB_URI=mongodb+srv://[YOUR_DATABASE_USERNAME]:[YOUR_DATABASE_PASSWORD]@[YOUR_CLUSTER_HOST]/shawan_school_test?retryWrites=true&w=majority

# JWT Secret (Generate safely via: openssl rand -hex 32)
JWT_SECRET=replace_with_minimum_32_character_cryptographic_secret

# CORS Trusted Origins
CORS_ORIGIN=http://localhost:5173

# Upload Storage Directory
UPLOAD_STORAGE_DIR=./uploads

# Seed Guards (Keep ALLOW_PRODUCTION_SEED=false so Atlas data is never auto-seeded)
ALLOW_PRODUCTION_SEED=false
DISABLE_AUTO_SEED=true

# Gemini API Key (Optional server-side key; never expose with VITE_ prefix)
GEMINI_API_KEY=

# One-Time Initial Super Admin Bootstrap (Set temporarily for fresh DB bootstrap, then remove)
BOOTSTRAP_SECRET=

# Transactional SMTP Configuration for Forgot Password Emails (Optional; fails safely with HTTP 503 if omitted)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Shawan School & College <no-reply@shawanschool.edu.pk>"
APP_PUBLIC_URL=

# ============================================================================
# FRONTEND CONFIGURATION
# ============================================================================

# Leave empty for same-origin unified server; set to https://your-backend-domain in split deployments
VITE_API_BASE_URL=